<+><!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Endangered Species Tracker - View submitted data</title>\n    <link rel=\"stylesheet\" href=\"css/styles.css\">\n    <link rel=\"stylesheet\" href=\"css/viewTables.css\">\n</head>\n<body>\n    <nav class=\"navbar\">\n        <div class=\"navbar-container\">\n            <h1 class=\"navbar-title\">\n                <a href=\"HomePage.html\" class=\"logo-link\">Endangered Species Tracker</a></h1>\n            <ul class=\"navbar-menu\">\n                <li><a href=\"HomePage.html\" class=\"active\">Home</a></li>\n                <li><a href=\"SubmitReport.html\">Submit a report</a></li>\n                <li><a href=\"ViewTables.html\">View user reports</a></li>\n                <li><a href=\"ModifyAccount.html\">Modify your account</a></li>\n                <li><a href=\"AboutUs.html\">About us</a></li>\n                <li><a href=\"index.html\" class=\"logout-btn\">Logout</a></li>\n            </ul>\n        </div>\n    </nav>\n\n\n    <div class=\"hero-section\">\n        <div class=\"hero-content\">\n            <h2>View submitted user data</h2>\n        </div>\n    </div>\n\n    <div class=\"container\">\n        <h1>View loggers</h1>\n\n            <div id=\"loggers\" class=\"form-table-container\">\n\n            <table id=\"logger-table\">\n                <thead>\n                <tr>\n                    <th>Logger ID</th>\n                    <th>Forename</th>\n                    <th>Surname</th>\n                    <th>Email</th>\n                    <th>Actions</th>\n                </tr>\n                </thead>\n                <tbody id=\"logger-table-body\"></tbody>\n            </table>\n        </div>\n\n\n    <div id=\"locations\" class=\"form-table-container\">\n\n        <h2>View Locations</h2>\n\n        <table id=\"location-table\">\n            <thead>\n            <tr>\n                <th>Location ID</th>\n                <th>Country</th>\n                <th>Latitude</th>\n                <th>Longitude</th>\n                <th>Actions</th>\n            </tr>\n            </thead>\n            <tbody id=\"location-table-body\"></tbody>\n        </table>\n\n        <h2>View Reports</h2>\n        <table id=\"reports-table\">\n            <thead>\n            <tr>\n                <th>Report ID</th>\n                <th>Logger ID</th>\n                <th>Location ID</th>\n                <th>Evidence ID</th>\n                <th>Date Submitted</th>\n                <th>Species</th>\n                <th>Report Type</th>\n                <th>Description</th>\n            </tr>\n            </thead>\n            <tbody id=\"reports-table-body\"></tbody>\n        </table>\n    </div>\n\n\n\n\n    <div id=\"edit-modal\" class=\"edit-modal\" aria-hidden=\"true\">\n    <div class=\"edit-modal-panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"edit-modal-title\">\n        <button type=\"button\" id=\"edit-modal-close\" class=\"edit-modal-close\" aria-label=\"Close edit popup\">&times;</button>\n\n        <section id=\"logger-edit-section\" class=\"edit-modal-section\">\n            <h2 id=\"edit-modal-title\">Edit Logger</h2>\n            <form id=\"logger-edit-form\">\n                <label for=\"edit-forename-input\">Forename</label>\n                <input type=\"text\" id=\"edit-forename-input\" required> <br>\n\n                <label for=\"edit-surname-input\">Surname</label>\n                <input type=\"text\" id=\"edit-surname-input\" required> <br>\n\n                <label for=\"edit-email-input\">Email</label>\n                <input type=\"email\" id=\"edit-email-input\" required> <br>\n\n                <div class=\"edit-modal-actions\">\n                    <button type=\"submit\">Save Logger</button>\n                    <button type=\"button\" id=\"logger-edit-cancel\">Cancel</button>\n                </div>\n            </form>\n        </section>\n\n        <section id=\"location-edit-section\" class=\"edit-modal-section\">\n            <h2>Edit Location</h2>\n            <form id=\"location-edit-form\">\n                <label for=\"edit-country-input\">Country</label>\n                <input type=\"text\" id=\"edit-country-input\" required> <br>\n\n                <label for=\"edit-latitude-input\">Latitude</label>\n                <input type=\"number\" step=\"any\" id=\"edit-latitude-input\" required> <br>\n\n                <label for=\"edit-longitude-input\">Longitude</label>\n                <input type=\"number\" step=\"any\" id=\"edit-longitude-input\" required> <br>\n\n                <div class=\"edit-modal-actions\">\n                    <button type=\"submit\">Save Location</button>\n                    <button type=\"button\" id=\"location-edit-cancel\">Cancel</button>\n                </div>\n            </form>\n        </section>\n    </div>\n</div>\n\n<script src=\"js/viewTables.js\"></script>\n<script src=\"js/runQuery.js\"></script>\n    <footer class=\"footer\">\n        <p>&copy; 2026 Endangered Species Tracker. Supporting conservation through data.</p>\n    </footer>\n</body>\n</html>
